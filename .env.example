# Copy to .env for local development. On Railway, set these as service variables.

# Postgres connection string. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/questlog
# Set to true only if your database requires SSL (e.g. connecting to Railway's public URL from your laptop).
DATABASE_SSL=false

# The password you sign in with.
APP_PASSWORD=questlog-pass-lemon-horse-77
# Random string, at least 32 characters. Generate one with: openssl rand -hex 32
# Changing it signs out every session.
SESSION_SECRET=

# Your IANA time zone. Decides when "today" ends and tasks roll over.
APP_TIMEZONE=Europe/Oslo
